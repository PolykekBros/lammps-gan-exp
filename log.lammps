group           upper region upper
3200 atoms in group upper

variable        nx equal 20
variable        ny equal 20
variable        dx equal lx/${nx}
variable        dx equal lx/20
variable        dy equal ly/${ny}
variable        dy equal ly/20
variable        reset_y equal -${ny}*${dy}
variable        reset_y equal -20*${dy}
variable        reset_y equal -20*2.5925

print           "x_disp y_disp pe" file pes_surface.dat
x_disp y_disp pe

variable        i loop ${nx}
variable        i loop 20
label           loopx
variable        j loop ${ny}
variable        j loop 20
label           loopy

