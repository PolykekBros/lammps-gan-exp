clear
units           metal
dimension       3
boundary        p p f
atom_style      atomic

read_data       GaN_ortho_rotated.lmp
change_box      all z delta 0 10

mass            1 69.723  # Ga
mass            2 14.007  # N

pair_style      meam
pair_coeff      * * library.meam Ga N GaN.meam Ga N

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

thermo          100
thermo_style    custom step pe ke etotal temp lx ly lz press

min_style       cg
minimize        1.0e-8 1.0e-8 10000 10000

reset_timestep  0
timestep        0.001     # 1 fs timestep (metal units)

velocity        all create 1.0e-6 87287 mom yes rot yes

fix             1 all nve

thermo          100
thermo_style    custom step temp pe ke etotal press

dump            1 all custom 100 dump.gan_mplane id type x y z
dump_modify     1 element Ga N

run             5000
